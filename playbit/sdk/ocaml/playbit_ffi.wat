;; OCaml GC arrays are copied through one bounded, reusable linear scratch area.
;; All syscall pointers are borrowed only until the synchronous call returns.
(module
    (type $bytes (array (mut i8)))
    (import "env" "memory" (memory 1))
    (import "env" "caml_copy_int64" (func $box (param i64) (result (ref eq))))
    (import "env" "Int32_val" (func $unbox (param (ref eq)) (result i32)))
    (import "env" "Int64_val" (func $unbox64 (param (ref eq)) (result i64)))
    (import "env" "caml_invalid_argument" (func $invalid (param (ref eq))))
    (import "env" "pb_log" (func $log (param i32 i32) (result i64)))
    (import "env" "pb_view_submit" (func $submit (param i32 i32) (result i64)))
    (import "env" "pb_event_poll" (func $poll (param i32 i32 i32) (result i64)))
    (import "env" "pb_event_poll_deadline" (func $poll_deadline (param i32 i32 i32 i64) (result i64)))
    (import "env" "pb_host_limit" (func $limit (param i32) (result i64)))
    (import "env" "pb_host_platform" (func $platform (result i64)))
    (import "env" "pb_quit_on_last_window" (func $quit (param i32) (result i64)))
    (import "env" "pb_call_slots" (func $call_slots (param i32 i64 i64 i64 i64 i64 i64) (result i64)))
    (@string $bad_buffer "Playbit buffer exceeds ABI limit")
    (func $ensure (param $length i32)
        (local $pages i32)
        (if (i32.gt_u (local.get $length) (i32.const @MAX_CALL_BYTES@))
            (then (call $invalid (global.get $bad_buffer))))
        (local.set $pages (i32.shr_u
            (i32.add (local.get $length) (i32.const 65567)) (i32.const 16)))
        (if (i32.gt_u (local.get $pages) (memory.size))
            (then
                (if (i32.eq (memory.grow (i32.sub (local.get $pages) (memory.size))) (i32.const -1))
                    (then unreachable)))))
    (func $to_memory (param $bytes (ref $bytes))
        (local $i i32) (local $length i32)
        (local.set $length (array.len (local.get $bytes)))
        (call $ensure (local.get $length))
        (block $done (loop $copy
            (br_if $done (i32.ge_u (local.get $i) (local.get $length)))
            (i32.store8 (i32.add (i32.const 32) (local.get $i))
                (array.get_u $bytes (local.get $bytes) (local.get $i)))
            (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $copy))))
    (func $from_memory (param $bytes (ref $bytes)) (param $pointer i32) (param $length i32)
        (local $i i32)
        (block $done (loop $copy
            (br_if $done (i32.ge_u (local.get $i) (local.get $length)))
            (array.set $bytes (local.get $bytes) (local.get $i)
                (i32.load8_u (i32.add (local.get $pointer) (local.get $i))))
            (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $copy))))
    (func (export "caml_pb_log") (param $value (ref eq)) (result (ref eq))
        (local $bytes (ref $bytes))
        (local.set $bytes (ref.cast (ref $bytes) (local.get $value)))
        (call $to_memory (local.get $bytes))
        (call $box (call $log (i32.const 32) (array.len (local.get $bytes)))))
    (func (export "caml_pb_view_submit") (param $value (ref eq)) (result (ref eq))
        (local $bytes (ref $bytes))
        (local.set $bytes (ref.cast (ref $bytes) (local.get $value)))
        (call $to_memory (local.get $bytes))
        (call $box (call $submit (i32.const 32) (array.len (local.get $bytes)))))
    (func (export "caml_pb_host_limit") (param $kind (ref eq)) (result (ref eq))
        (call $box (call $limit (call $unbox (local.get $kind)))))
    ;; The first 48 bytes hold six full-width argument slots. Typed OCaml
    ;; adapters place borrowed records after them; pointers refer to this same
    ;; bounded scratch area. Copy output before another call can reuse it.
    (func (export "caml_pb_call_packet") (param $opcode (ref eq)) (param $value (ref eq)) (result (ref eq))
        (local $bytes (ref $bytes)) (local $length i32) (local $result i64)
        (local.set $bytes (ref.cast (ref $bytes) (local.get $value)))
        (local.set $length (array.len (local.get $bytes)))
        (if (i32.lt_u (local.get $length) (i32.const 48))
            (then (call $invalid (global.get $bad_buffer))))
        (call $to_memory (local.get $bytes))
        (local.set $result (call $call_slots (call $unbox (local.get $opcode))
            (i64.load (i32.const 32)) (i64.load (i32.const 40))
            (i64.load (i32.const 48)) (i64.load (i32.const 56))
            (i64.load (i32.const 64)) (i64.load (i32.const 72))))
        (call $from_memory (local.get $bytes) (i32.const 32) (local.get $length))
        (call $box (local.get $result)))
    (func (export "caml_pb_host_platform") (param (ref eq)) (result (ref eq))
        (call $box (call $platform)))
    (func (export "caml_pb_quit_on_last_window") (param $intent (ref eq)) (result (ref eq))
        (call $box (call $quit (i31.get_u (ref.cast (ref i31) (local.get $intent))))))
    (func (export "caml_pb_event_poll")
        (param $header_value (ref eq)) (param $data_value (ref eq)) (result (ref eq))
        (call $poll_one (local.get $header_value) (local.get $data_value) (i32.const 0) (i64.const 0)))
    (func (export "caml_pb_event_poll_deadline")
        (param $deadline (ref eq)) (param $header_value (ref eq)) (param $data_value (ref eq)) (result (ref eq))
        (call $poll_one (local.get $header_value) (local.get $data_value)
            (i32.const 1) (call $unbox64 (local.get $deadline))))
    (func $poll_one (param $header_value (ref eq)) (param $data_value (ref eq))
        (param $wait i32) (param $deadline i64) (result (ref eq))
        (local $header (ref $bytes)) (local $data (ref $bytes))
        (local $capacity i32) (local $result i64)
        (local.set $header (ref.cast (ref $bytes) (local.get $header_value)))
        (local.set $data (ref.cast (ref $bytes) (local.get $data_value)))
        (local.set $capacity (array.len (local.get $data)))
        (if (i32.or (i32.ne (array.len (local.get $header)) (i32.const @EVENT_BYTES@))
            (i32.gt_u (local.get $capacity) (i32.const @MAX_EVENT_BYTES@)))
            (then (call $invalid (global.get $bad_buffer))))
        (call $ensure (local.get $capacity))
        (i32.store (i32.const 8) (i32.const @EVENT_BYTES@))
        (i32.store (i32.const 12) (i32.const 0))
        (local.set $result (if (result i64) (local.get $wait)
            (then (call $poll_deadline (i32.const 8) (i32.const 32) (local.get $capacity) (local.get $deadline)))
            (else (call $poll (i32.const 8) (i32.const 32) (local.get $capacity)))))
        (if (i32.and (i64.ge_s (local.get $result) (i64.const 0))
            (i64.le_u (local.get $result) (i64.extend_i32_u (local.get $capacity))))
            (then
                (call $from_memory (local.get $header) (i32.const 8) (i32.const @EVENT_BYTES@))
                (call $from_memory (local.get $data) (i32.const 32) (i32.wrap_i64 (local.get $result)))))
        (call $box (local.get $result)))
)
