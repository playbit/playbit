;; A real event-pumped guest: locate the root, inspect schema, create, edit,
;; read, query, and render through the scalar boundary.
;; Every data operation executes between turns and resumes on its exact ready event.
(module
    (import "playbit" "pb_syscall" (func $dispatch_caps (param i32 i64 i64 i64 i64 i64 i64) (result i64)))
    (import "playbit" "pb_syscall" (func $dispatch_identity (param i32 i64 i64 i64 i64 i64 i64) (result i64)))
    (import "playbit" "pb_syscall" (func $dispatch_args (param i32 i64 i64 i64 i64 i64 i64) (result i64)))
    (import "playbit" "pb_syscall" (func $dispatch_presence (param i32 i64 i64 i64 i64 i64 i64) (result i64)))
    (import "playbit" "pb_syscall" (func $dispatch_volumes (param i32 i64 i64 i64 i64 i64 i64) (result i64)))
    (import "playbit" "pb_syscall" (func $dispatch_schema (param i32 i64 i64 i64 i64 i64 i64) (result i64)))
    (import "playbit" "pb_syscall" (func $dispatch_log (param i32 i64 i64 i64 i64 i64 i64) (result i64)))
    (import "playbit" "pb_syscall" (func $dispatch_view (param i32 i64 i64 i64 i64 i64 i64) (result i64)))
    (import "playbit" "pb_syscall" (func $dispatch_event (param i32 i64 i64 i64 i64 i64 i64) (result i64)))

    ;; This guest retains scalar handle results for subsequent turns.
    (func $save_handle (param $output i32) (param $result i64) (result i32)
        (if (result i32) (i64.lt_s (local.get $result) (i64.const 0))
            (then (i32.wrap_i64 (local.get $result)))
            (else (i64.store (local.get $output) (local.get $result)) (i32.const 0))))
    (func $caps (param i32) (result i32)
        (i32.wrap_i64 (call $dispatch_caps (i32.const 1)
            (i64.extend_i32_u (local.get 0)) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0))))
    (func $identity (param i32) (result i32)
        (i32.wrap_i64 (call $dispatch_identity (i32.const 5)
            (i64.extend_i32_u (local.get 0)) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0))))
    (func $args (param i32) (result i32)
        (i32.wrap_i64 (call $dispatch_args (i32.const 6)
            (i64.extend_i32_u (local.get 0)) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0))))
    (func $presence (param i32) (result i32)
        (i32.wrap_i64 (call $dispatch_presence (i32.const 10)
            (i64.extend_i32_u (local.get 0)) (i64.const 8) (i64.const 88) (i64.const 64) (i64.const 0) (i64.const 0))))
    (func $volumes (param i32) (result i32)
        (i32.wrap_i64 (call $dispatch_volumes (i32.const 7)
            (i64.extend_i32_u (local.get 0)) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0))))
    (func $schema_begin (param i64 i32 i32) (result i32)
        (call $save_handle (i32.wrap_i64 (i64.extend_i32_u (local.get 2))) (call $dispatch_schema (i32.const 258)
            (i64.const 9000) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0))))
    (func $schema_take (param i32) (result i32)
        (i32.wrap_i64 (call $dispatch_schema (i32.const 259)
            (i64.load (i32.const 9040)) (i64.extend_i32_u (local.get 0)) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0))))
    (func $data (param i32 i64 i64 i64 i64 i64 i64) (result i32)
        (i32.wrap_i64 (call $dispatch_caps (local.get 0) (local.get 1)
            (local.get 2) (local.get 3) (local.get 4) (local.get 5) (local.get 6))))
    (func $data64 (param i32 i64 i64 i64 i64 i64 i64) (result i64)
        (call $dispatch_caps (local.get 0) (local.get 1)
            (local.get 2) (local.get 3) (local.get 4) (local.get 5) (local.get 6)))
    (global $phase (mut i32) (i32.const 0))

    (func $log (param i32 i32) (result i32)
        (i32.wrap_i64 (call $dispatch_log (i32.const 2)
            (i64.extend_i32_u (local.get 0)) (i64.extend_i32_u (local.get 1)) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0))))
    (func $view (param i32 i32) (result i32)
        (i32.wrap_i64 (call $dispatch_view (i32.const 3)
            (i64.extend_i32_u (local.get 0)) (i64.extend_i32_u (local.get 1)) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0))))
    (func $event (param i32 i32 i32) (result i32)
        (i32.wrap_i64 (call $dispatch_event (i32.const 4)
            (i64.extend_i32_u (local.get 0)) (i64.extend_i32_u (local.get 1)) (i64.extend_i32_u (local.get 2)) (i64.const 0) (i64.const 0) (i64.const 0))))
    ;; Literal wasm32 layouts are frozen by playbit-api/tests/abi_prefix.rs.
    (memory (export "memory") 2)
    (data (i32.const 11000) "Hello")
    (data (i32.const 12000) "PBV1\01\00\00\00\00\00\00\00\00\02\00\00\00\00\06\00\00\00\00Ready\04\00\00\00\00\00\00\00\00")
    (data (i32.const 12288) "\02\02\02\02\02\02\02\02\02\02\02\02\02\02\02\02")
    (data (i32.const 12304) "\03\03\03\03\03\03\03\03\03\03\03\03\03\03\03\03")
    (func $expect (param $actual i32) (param $expected i32)
        (if (i32.ne (local.get $actual) (local.get $expected)) (then unreachable)))
    (func $record (param $address i32) (param $size i32)
        (memory.fill (local.get $address) (i32.const 0) (local.get $size))
        (i32.store (local.get $address) (local.get $size)))
    (func $buffer (param $descriptor i32) (param $data i32) (param $capacity i32)
        (i32.store (local.get $descriptor) (local.get $data))
        (i32.store offset=4 (local.get $descriptor) (local.get $capacity))
        (i32.store offset=8 (local.get $descriptor) (i32.const 0)))
    (func $array (param $descriptor i32) (param $data i32) (param $capacity i32) (param $stride i32)
        (local $index i32)
        (call $buffer (local.get $descriptor) (local.get $data) (local.get $capacity))
        (i32.store offset=12 (local.get $descriptor) (local.get $stride))
        (block $done (loop $slots
            (br_if $done (i32.eq (local.get $index) (local.get $capacity)))
            (call $record (i32.add (local.get $data) (i32.mul (local.get $index) (local.get $stride))) (local.get $stride))
            (local.set $index (i32.add (local.get $index) (i32.const 1)))
            (br $slots))))
    (func $schema_output
        (call $record (i32.const 64) (i32.const 52))
        (call $array (i32.const 72) (i32.const 1024) (i32.const 8) (i32.const 48))
        (call $array (i32.const 88) (i32.const 2048) (i32.const 32) (i32.const 56))
        (call $buffer (i32.const 104) (i32.const 4096) (i32.const 1024)))
    (func $start (local $remaining i32) (local $cursor i32) (local $found i32)
        (call $record (i32.const 64) (i32.const 36))
        (call $array (i32.const 72) (i32.const 1024) (i32.const 64) (i32.const 16))
        (call $buffer (i32.const 88) (i32.const 4096) (i32.const 4096))
        (call $expect (call $caps (i32.const 64)) (i32.const 0))
        (call $record (i32.const 64) (i32.const 104))
        (call $expect (call $identity (i32.const 64)) (i32.const 0))
        (call $record (i32.const 64) (i32.const 36))
        (call $array (i32.const 72) (i32.const 1024) (i32.const 32) (i32.const 24))
        (call $buffer (i32.const 88) (i32.const 4096) (i32.const 4096))
        (call $expect (call $args (i32.const 64)) (i32.const 0))
        (call $array (i32.const 64) (i32.const 1024) (i32.const 8) (i32.const 88))
        (call $expect (call $presence (i32.const 1024)) (i32.const 0))
        (call $record (i32.const 64) (i32.const 64))
        (call $array (i32.const 80) (i32.const 1024) (i32.const 2) (i32.const 80))
        (call $array (i32.const 96) (i32.const 2048) (i32.const 128) (i32.const 16))
        (call $buffer (i32.const 112) (i32.const 4096) (i32.const 4096))
        (call $expect (call $volumes (i32.const 64)) (i32.const 0))
        (local.set $remaining (i32.load (i32.const 88)))
        (local.set $cursor (i32.const 1024))
        (call $record (i32.const 9000) (i32.const 32))
        (memory.fill (i32.const 9016) (i32.const 5) (i32.const 15))
        (loop $find_root
            (if (i32.and (i32.load offset=52 (local.get $cursor)) (i32.const 1))
                (then
                    (memory.copy (i32.const 9008) (i32.add (local.get $cursor) (i32.const 8)) (i32.const 8))
                    (local.set $found (i32.const 1))))
            (local.set $cursor (i32.add (local.get $cursor) (i32.const 80)))
            (local.set $remaining (i32.sub (local.get $remaining) (i32.const 1)))
            (br_if $find_root (local.get $remaining)))
        (call $expect (local.get $found) (i32.const 1))
        (global.set $phase (i32.const 1))
        (call $expect (call $schema_begin (i64.const 0) (i32.const 0) (i32.const 9040)) (i32.const 0))
        (call $schema_output)
        (call $expect (call $schema_take (i32.const 64)) (i32.const -6)))
    (func $complete
        (if (i32.eq (global.get $phase) (i32.const 1)) (then
            (call $schema_output)
            (call $expect (call $schema_take (i32.const 64)) (i32.const 0))
            (call $expect (i32.load (i32.const 80)) (i32.const 1))
            (global.set $phase (i32.const 2))
            (call $expect (call $save_handle (i32.wrap_i64 (i64.const 9040)) (call $data64 (i32.const 276) (i64.const 9000)
                (i64.const 12288) (i64.const 0) (i64.const 0) (i64.const 40) (i64.const 0))) (i32.const 0))
            return))
        (if (i32.eq (global.get $phase) (i32.const 2)) (then
            (call $expect (call $data (i32.const 277) (i64.load (i32.const 9040))
                (i64.const 9088) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0)) (i32.const 0))
            (call $record (i32.const 10000) (i32.const 40))
            (memory.copy (i32.const 10008) (i32.const 12304) (i32.const 16))
            (i32.store (i32.const 10024) (i32.const 10080))
            (i32.store (i32.const 10028) (i32.const 1))
            (i32.store (i32.const 10032) (i32.const 80))
            (i32.store (i32.const 10036) (i32.const 1))
            (call $record (i32.const 10080) (i32.const 80))
            (i32.store (i32.const 10088) (i32.const 3))
            (i64.store (i32.const 10096) (i64.const 42))
            (global.set $phase (i32.const 3))
            (call $expect (call $save_handle (i32.wrap_i64 (i64.const 9040)) (call $data64 (i32.const 306) (i64.const 9000)
                (i64.const 9088) (i64.const 10000) (i64.const 1) (i64.const 40) (i64.const 0))) (i32.const 0))
            return))
        (if (i32.eq (global.get $phase) (i32.const 3)) (then
            (call $expect (call $data (i32.const 307) (i64.load (i32.const 9040))
                (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0)) (i32.const 0))
            (call $record (i32.const 64) (i32.const 68))
            (call $array (i32.const 88) (i32.const 1024) (i32.const 1) (i32.const 40))
            (call $array (i32.const 104) (i32.const 2048) (i32.const 1) (i32.const 80))
            (call $buffer (i32.const 120) (i32.const 4096) (i32.const 256))
            (global.set $phase (i32.const 4))
            (call $expect (call $save_handle (i32.wrap_i64 (i64.const 9040)) (call $data64 (i32.const 304) (i64.const 9000)
                (i64.const 9088) (i64.const 12304) (i64.const 1) (i64.const 0) (i64.const 0))) (i32.const 0))
            return))
        (if (i32.eq (global.get $phase) (i32.const 4)) (then
            (call $expect (call $data (i32.const 305) (i64.load (i32.const 9040))
                (i64.const 64) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0)) (i32.const 0))
            (if (i64.ne (i64.load (i32.const 2064)) (i64.const 42)) (then unreachable))
            (call $record (i32.const 10000) (i32.const 60))
            (memory.copy (i32.const 10008) (i32.const 12288) (i32.const 16))
            (i32.store (i32.const 10044) (i32.const 64))
            (call $record (i32.const 64) (i32.const 92))
            (call $array (i32.const 96) (i32.const 1024) (i32.const 1) (i32.const 48))
            (call $array (i32.const 112) (i32.const 0) (i32.const 0) (i32.const 40))
            (call $array (i32.const 128) (i32.const 0) (i32.const 0) (i32.const 80))
            (call $buffer (i32.const 144) (i32.const 0) (i32.const 0))
            (global.set $phase (i32.const 5))
            (call $expect (call $save_handle (i32.wrap_i64 (i64.const 9040)) (call $data64 (i32.const 308) (i64.const 9000)
                (i64.const 10000) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0))) (i32.const 0))
            return))
        (call $expect (global.get $phase) (i32.const 5))
        (call $expect (call $data (i32.const 309) (i64.load (i32.const 9040))
            (i64.const 64) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0)) (i32.const 0))
        (call $expect (i32.load (i32.const 104)) (i32.const 1))
        (global.set $phase (i32.const 6))
        (call $expect (call $log (i32.const 11000) (i32.const 5)) (i32.const 0))
        (call $expect (call $view (i32.const 12000) (i32.const 37)) (i32.const 0)))
    (func (export "pb_main") (local $status i32)
        (loop $events
            (call $record (i32.const 16384) (i32.const 24))
            (local.set $status (call $event (i32.const 16384) (i32.const 16416) (i32.const 1024)))
            (if (i32.eq (local.get $status) (i32.const -6)) (then return))
            (if (i32.lt_s (local.get $status) (i32.const 0)) (then unreachable))
            (if (i32.eq (i32.load (i32.const 16400)) (i32.const 1))
                (then (call $start))
                (else
                    (if (i32.or (i32.eq (i32.load (i32.const 16400)) (i32.const 16))
                        (i32.eq (i32.load (i32.const 16400)) (i32.const 7)))
                        (then
                            (call $expect (local.get $status) (i32.const 8))
                            (if (i64.ne (i64.load (i32.const 16416)) (i64.load (i32.const 9040))) (then unreachable))
                            (call $complete))
                        (else (call $expect (call $log (i32.const 16416) (local.get $status)) (i32.const 0))))))
            (br $events))))
