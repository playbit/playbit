;; One-volume asynchronous creation guest used on Native and Pulley. Started
;; enqueues creation; a later ready event polls the handle and logs completion.
(module
    (import "playbit" "pb_syscall" (func $dispatch_event (param i32 i64 i64 i64 i64 i64 i64) (result i64)))
    (import "playbit" "pb_syscall" (func $dispatch_volumes (param i32 i64 i64 i64 i64 i64 i64) (result i64)))
    (import "playbit" "pb_syscall" (func $dispatch_capabilities (param i32 i64 i64 i64 i64 i64 i64) (result i64)))
    (import "playbit" "pb_syscall" (func $dispatch_begin (param i32 i64 i64 i64 i64 i64 i64) (result i64)))
    (import "playbit" "pb_syscall" (func $dispatch_poll (param i32 i64 i64 i64 i64 i64 i64) (result i64)))
    (import "playbit" "pb_syscall" (func $dispatch_log (param i32 i64 i64 i64 i64 i64 i64) (result i64)))

    ;; This guest retains scalar handle results for subsequent turns.
    (func $save_handle (param $output i32) (param $result i64) (result i32)
        (if (result i32) (i64.lt_s (local.get $result) (i64.const 0))
            (then (i32.wrap_i64 (local.get $result)))
            (else (i64.store (local.get $output) (local.get $result)) (i32.const 0))))
    (func $event (param i32 i32 i32) (result i32)
        (i32.store (local.get 0) (i32.const 24))
        (i32.store offset=4 (local.get 0) (i32.const 0))
        (i32.wrap_i64 (call $dispatch_event (i32.const 4)
            (i64.extend_i32_u (local.get 0)) (i64.extend_i32_u (local.get 1)) (i64.extend_i32_u (local.get 2)) (i64.const 0) (i64.const 0) (i64.const 0))))
    (func $volumes (param i32) (result i32)
        (i32.wrap_i64 (call $dispatch_volumes (i32.const 7)
            (i64.extend_i32_u (local.get 0)) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0))))
    (func $capabilities (param i32) (result i32)
        (i32.wrap_i64 (call $dispatch_capabilities (i32.const 1)
            (i64.extend_i32_u (local.get 0)) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0))))
    (func $begin (param i32 i32 i32) (result i32)
        (call $save_handle (i32.wrap_i64 (i64.extend_i32_u (local.get 2))) (call $dispatch_begin (i32.const 276)
            (i64.extend_i32_u (local.get 0)) (i64.extend_i32_u (local.get 1))
            (i64.const 0) (i64.const 0) (i64.const 40) (i64.const 0))))
    (func (export "begin_fields") (param i32 i32 i32 i32 i32) (result i32)
        (call $save_handle (i32.wrap_i64 (i64.extend_i32_u (local.get 4))) (call $dispatch_begin (i32.const 276)
            (i64.extend_i32_u (local.get 0)) (i64.extend_i32_u (local.get 1))
            (i64.extend_i32_u (local.get 2)) (i64.extend_i32_u (local.get 3))
            (i64.const 40) (i64.const 0))))
    (func $poll (param i64 i32 i32) (result i32)
        (i32.wrap_i64 (call $dispatch_poll (i32.const 277)
            (i64.or (i64.shl (local.get 0) (i64.const 32)) (i64.extend_i32_u (local.get 1))) (i64.extend_i32_u (local.get 2)) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0))))
    (func $log (param i32 i32) (result i32)
        (i32.wrap_i64 (call $dispatch_log (i32.const 2)
            (i64.extend_i32_u (local.get 0)) (i64.extend_i32_u (local.get 1)) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0))))
    (func (export "invoke") (param i32 i64 i64 i64 i64 i64 i64) (result i64)
        (call $dispatch_begin
            (local.get 0) (local.get 1) (local.get 2) (local.get 3) (local.get 4) (local.get 5) (local.get 6)))
    (memory (export "memory") 2)
    (data (i32.const 4096) "\02\02\02\02\02\02\02\02\02\02\02\02\02\02\02\02")
    (data (i32.const 60016) "\05\05\05\05\05\05\05\05\05\05\05\05\05\05\05")
    (data (i32.const 5000) "Created")
    (func $expect (param $actual i32) (param $expected i32)
        (if (i32.ne (local.get $actual) (local.get $expected)) (then unreachable)))
    (func (export "begin") (param i32 i32 i32) (result i32)
        local.get 0 local.get 1 local.get 2 call $begin)
    (func (export "poll") (param i64 i32 i32) (result i32)
        local.get 0 local.get 1 local.get 2 call $poll)
    (func (export "event") (param i32 i32 i32) (result i32)
        local.get 0 local.get 1 local.get 2 call $event)
    (func (export "capabilities") (param i32) (result i32) local.get 0 call $capabilities)
    (func (export "pb_main") (local $status i32) (local $kind i32)
        (loop $events
            (local.set $status (call $event (i32.const 1024) (i32.const 1056) (i32.const 1024)))
            (if (i32.eq (local.get $status) (i32.const -6)) (then return))
            (if (i32.lt_s (local.get $status) (i32.const 0)) (then unreachable))
            (local.set $kind (i32.load (i32.const 1040)))
            (if (i32.eq (local.get $kind) (i32.const 1))
                (then
                    ;; One volume record and its name; no tags in this fixture.
                    (i32.store (i32.const 64) (i32.const 64))
                    (i32.store (i32.const 80) (i32.const 2048))
                    (i32.store (i32.const 84) (i32.const 1))
                    (i32.store (i32.const 92) (i32.const 80))
                    (i32.store (i32.const 108) (i32.const 16))
                    (i32.store (i32.const 112) (i32.const 3072))
                    (i32.store (i32.const 116) (i32.const 128))
                    (i32.store (i32.const 2048) (i32.const 80))
                    (call $expect (call $volumes (i32.const 64)) (i32.const 0))
                    (call $expect (i32.load (i32.const 88)) (i32.const 1))
                    (i32.store (i32.const 60000) (i32.const 32))
                    (memory.copy (i32.const 60008) (i32.const 2056) (i32.const 8))
                    (call $expect (call $begin (i32.const 60000) (i32.const 4096) (i32.const 4200)) (i32.const 0))
                    (call $expect (call $poll (i64.extend_i32_u (i32.load (i32.const 4204))) (i32.load (i32.const 4200)) (i32.const 4300)) (i32.const -6))))
            (if (i32.eq (local.get $kind) (i32.const 7))
                (then
                    (call $expect (local.get $status) (i32.const 8))
                    (call $expect (call $poll (i64.extend_i32_u (i32.load (i32.const 1060))) (i32.load (i32.const 1056)) (i32.const 4300)) (i32.const 0))
                    (drop (call $log (i32.const 5000) (i32.const 7)))))
            (br $events))))
