;; Host-owned native selection completes with a scoped reference or cancellation.
(module
    (import "playbit" "pb_syscall" (func $dispatch_begin (param i32 i64 i64 i64 i64 i64 i64) (result i64)))
    (import "playbit" "pb_syscall" (func $dispatch_poll (param i32 i64 i64 i64 i64 i64 i64) (result i64)))
    (import "playbit" "pb_syscall" (func $dispatch_event (param i32 i64 i64 i64 i64 i64 i64) (result i64)))
    (import "playbit" "pb_syscall" (func $dispatch_caps (param i32 i64 i64 i64 i64 i64 i64) (result i64)))
    (import "playbit" "pb_syscall" (func $dispatch_log (param i32 i64 i64 i64 i64 i64 i64) (result i64)))
    (import "playbit" "pb_syscall" (func $dispatch_create_begin (param i32 i64 i64 i64 i64 i64 i64) (result i64)))
    (import "playbit" "pb_syscall" (func $dispatch_create_poll (param i32 i64 i64 i64 i64 i64 i64) (result i64)))
    (import "playbit" "pb_syscall" (func $dispatch_copy_begin (param i32 i64 i64 i64 i64 i64 i64) (result i64)))
    (import "playbit" "pb_syscall" (func $dispatch_copy_poll (param i32 i64 i64 i64 i64 i64 i64) (result i64)))

    ;; This guest retains scalar handle results for subsequent turns.
    (func $save_handle (param $output i32) (param $result i64) (result i32)
        (if (result i32) (i64.lt_s (local.get $result) (i64.const 0))
            (then (i32.wrap_i64 (local.get $result)))
            (else (i64.store (local.get $output) (local.get $result)) (i32.const 0))))
    (func $begin (param i32) (result i32)
        (call $save_handle (i32.wrap_i64 (i64.extend_i32_u (local.get 0))) (call $dispatch_begin (i32.const 290)
            (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0))))
    (func $poll (param i64 i32 i32) (result i32)
        (i32.wrap_i64 (call $dispatch_poll (i32.const 291)
            (i64.or (i64.shl (local.get 0) (i64.const 32)) (i64.extend_i32_u (local.get 1))) (i64.extend_i32_u (local.get 2)) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0))))
    (func $event (param i32 i32 i32) (result i32)
        (i32.store (local.get 0) (i32.const 24))
        (i32.store offset=4 (local.get 0) (i32.const 0))
        (i32.wrap_i64 (call $dispatch_event (i32.const 4)
            (i64.extend_i32_u (local.get 0)) (i64.extend_i32_u (local.get 1)) (i64.extend_i32_u (local.get 2)) (i64.const 0) (i64.const 0) (i64.const 0))))
    (func $caps (param i32) (result i32)
        (i32.wrap_i64 (call $dispatch_caps (i32.const 1)
            (i64.extend_i32_u (local.get 0)) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0))))
    (func $log (param i32 i32) (result i32)
        (i32.wrap_i64 (call $dispatch_log (i32.const 2)
            (i64.extend_i32_u (local.get 0)) (i64.extend_i32_u (local.get 1)) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0))))
    (func $create_begin (param i32 i32 i32) (result i32)
        (call $save_handle (i32.wrap_i64 (i64.extend_i32_u (local.get 2))) (call $dispatch_create_begin (i32.const 276)
            (i64.extend_i32_u (local.get 0)) (i64.extend_i32_u (local.get 1))
            (i64.const 0) (i64.const 0) (i64.const 40) (i64.const 0))))
    (func $create_poll (param i64 i32 i32) (result i32)
        (i32.wrap_i64 (call $dispatch_create_poll (i32.const 277)
            (i64.or (i64.shl (local.get 0) (i64.const 32)) (i64.extend_i32_u (local.get 1))) (i64.extend_i32_u (local.get 2)) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0))))
    (func $copy_begin (param i32 i32 i32) (result i32)
        (call $save_handle (i32.wrap_i64 (i64.extend_i32_u (local.get 2))) (call $dispatch_copy_begin (i32.const 278)
            (i64.extend_i32_u (local.get 0)) (i64.extend_i32_u (local.get 1)) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0))))
    (func $copy_poll (param i64 i32 i32) (result i32)
        (i32.wrap_i64 (call $dispatch_copy_poll (i32.const 279)
            (i64.or (i64.shl (local.get 0) (i64.const 32)) (i64.extend_i32_u (local.get 1))) (i64.extend_i32_u (local.get 2)) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0))))
    (memory (export "memory") 2)
    (data (i32.const 4096) "\02\02\02\02\02\02\02\02\02\02\02\02\02\02\02\02")
    (data (i32.const 5000) "SelectedCancelled")
    (func $expect (param $actual i32) (param $expected i32)
        (if (i32.ne (local.get $actual) (local.get $expected)) (then unreachable)))
    (func (export "begin") (param i32) (result i32)
        local.get 0 call $begin)
    (func (export "poll") (param i64 i32 i32) (result i32)
        local.get 0 local.get 1 local.get 2 call $poll)
    (func (export "event") (param i32 i32 i32) (result i32)
        local.get 0 local.get 1 local.get 2 call $event)
    (func (export "capabilities") (param i32) (result i32) local.get 0 call $caps)
    (func (export "create_begin") (param i32 i32 i32) (result i32)
        local.get 0 local.get 1 local.get 2 call $create_begin)
    (func (export "create_poll") (param i64 i32 i32) (result i32)
        local.get 0 local.get 1 local.get 2 call $create_poll)
    (func (export "copy_begin") (param i32 i32 i32) (result i32)
        local.get 0 local.get 1 local.get 2 call $copy_begin)
    (func (export "copy_poll") (param i64 i32 i32) (result i32)
        local.get 0 local.get 1 local.get 2 call $copy_poll)
    (func (export "pb_main") (local $status i32) (local $kind i32)
        (loop $events
            (local.set $status (call $event (i32.const 1024) (i32.const 1056) (i32.const 1024)))
            (if (i32.eq (local.get $status) (i32.const -6)) (then return))
            (if (i32.lt_s (local.get $status) (i32.const 0)) (then unreachable))
            (local.set $kind (i32.load (i32.const 1040)))
            (if (i32.eq (local.get $kind) (i32.const 1))
                (then
                    (i32.store (i32.const 4304) (i32.const 40))
                    (call $expect (call $begin (i32.const 4200)) (i32.const 0))
                    (call $expect (call $poll (i64.extend_i32_u (i32.load (i32.const 4204))) (i32.load (i32.const 4200)) (i32.const 4304)) (i32.const -6))))
            (if (i32.eq (local.get $kind) (i32.const 9))
                (then
                    (call $expect (local.get $status) (i32.const 8))
                    (call $expect (i32.load (i32.const 1044)) (i32.const 0))
                    (call $expect (call $poll (i64.extend_i32_u (i32.load (i32.const 1060))) (i32.load (i32.const 1056)) (i32.const 4304)) (i32.const 0))
                    (if (i32.eqz (i32.load (i32.const 4312)))
                        (then (drop (call $log (i32.const 5008) (i32.const 9))))
                        (else
                            (call $expect (i32.load (i32.const 4312)) (i32.const 1))
                            (call $expect (i64.gt_s (i64.load (i32.const 4320)) (i64.const 0)) (i32.const 1))
                            (call $expect (i32.load (i32.const 4328)) (i32.const 84215045))

                            (drop (call $log (i32.const 5000) (i32.const 8)))))))
            (br $events))))
