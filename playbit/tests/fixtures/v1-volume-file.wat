(call $ok (call $save_handle (i32.wrap_i64 (i64.const 128)) (call $sys (i32.const 294) (i64.load (i32.const 136)) (i64.const 0) (i64.const 2056) (i64.const 5) (i64.const 0) (i64.const 0))))
